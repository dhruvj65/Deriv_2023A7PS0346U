# IDE / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini

# NOTE: .cache/llm_cache.json is committed on purpose (model responses only, no secrets)
# so that `python validate.py` can replay LLM-mode runs without an API key.
